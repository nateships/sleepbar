{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // best-practices: config migration, pin GitHub Actions to SHA digests,
  // dependency dashboard issue.
  extends: ["config:best-practices"],
  labels: ["dependencies"],
  // Wait for a release to age before proposing it. Limits exposure to a
  // compromised tag that gets pulled quickly.
  minimumReleaseAge: "3 days",
  packageRules: [
    {
      // GitHub Actions: patch, minor, and digest bumps merge once CI passes.
      // Majors open a PR for review.
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
      automerge: true,
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["major"],
      groupName: "GitHub Actions (major)",
    },
    {
      // Tool pins in mise.toml (gh, xcbeautify, actionlint).
      matchManagers: ["mise"],
      groupName: "mise tools",
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      matchManagers: ["mise"],
      matchUpdateTypes: ["major"],
      groupName: "mise tools (major)",
    },
  ],
  // Sparkle is resolved by Xcode's Swift Package Manager inside the
  // xcodeproj. Renovate has no manager for that. Update it in Xcode:
  // File -> Packages -> Update to Latest Package Versions.
}
